# Copie este arquivo para ".env" (sem o ".example") e cole sua chave real ali.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub (já está no .gitignore).
GEMINI_API_KEY=cole_sua_chave_aqui
PORT=3000

# Pasta onde os arquivos (fotos/PDFs) dos cupons ficam guardados.
# Opcional: se não definir, usa uma pasta "uploads" dentro do backend.
# Em produção, aponte pro HD externo, ex: /mnt/hd/assistente-viagem-arquivos
FILES_DIR=
