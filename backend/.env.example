# Copie este arquivo para ".env" (sem o ".example") e cole sua chave real ali.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub (já está no .gitignore).
GEMINI_API_KEY=cole_sua_chave_aqui
PORT=3000

# Pasta onde os arquivos (fotos/PDFs) dos cupons ficam guardados.
# Opcional: se não definir, usa uma pasta "uploads" dentro do backend.
# Em produção, aponte pro HD externo, ex: /mnt/hd/assistente-viagem-arquivos
FILES_DIR=

# Ponto de montagem do HD externo (ex: /media/devmon/NasPi). Opcional, mas
# recomendado: se definido, o servidor só sobe se houver um disco realmente
# montado ali e FILES_DIR estiver dentro dele (evita gravar no cartão SD).
FILES_MOUNTPOINT=

# Client ID do OAuth do Google (Google Cloud Console > APIs e Serviços >
# Credenciais > ID do cliente OAuth 2.0, tipo "Aplicativo da Web").
# Precisa ser EXATAMENTE o mesmo valor colado em login.js (GOOGLE_CLIENT_ID),
# já que o backend usa esse valor pra validar de quem é o token.
GOOGLE_CLIENT_ID=cole_aqui_o_client_id_do_google

# Chave secreta pra assinar as sessões (JWT) — string aleatória longa.
# Gere com: openssl rand -hex 32
# NUNCA compartilhe nem envie pro GitHub. Trocar esse valor derruba todas
# as sessões ativas (todo mundo precisa logar de novo).
SESSION_SECRET=
